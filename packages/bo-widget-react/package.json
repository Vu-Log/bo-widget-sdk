{
  "name": "@vulog/bo-widget-react",
  "version": "0.0.0",
  "description": "React bindings for Vulog back office widgets: Web Component wrapper with Shadow DOM and MUI support, and hooks.",
  "license": "MIT",
  "author": "Vulog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vu-Log/bo-widget-sdk.git",
    "directory": "packages/bo-widget-react"
  },
  "homepage": "https://github.com/Vu-Log/bo-widget-sdk/tree/main/packages/bo-widget-react#readme",
  "bugs": "https://github.com/Vu-Log/bo-widget-sdk/issues",
  "keywords": [
    "vulog",
    "back-office",
    "widget",
    "react",
    "mui",
    "web-component"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/testing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only && node --input-type=module -e \"const m = await import('@vulog/bo-widget-react'); if (typeof m.toCustomElement !== 'function' || typeof m.renderIframeWidget !== 'function' || typeof m.useBoContext !== 'function') throw new Error('@vulog/bo-widget-react: exports not resolved from dist');\""
  },
  "dependencies": {
    "@vulog/bo-widget-sdk": "^0.1.0-next.2"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.0.0",
    "@emotion/react": "^11.5.0",
    "@mui/material": "^5.15.0 || ^6.0.0 || ^7.0.0 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.5.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
