{
  "name": "bo-widget-sdk-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/bo-widget-sdk",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13 || ^24 || >=26"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/template-floors.mjs",
    "release": "npm run build && npm run check:package && changeset publish",
    "release:next:dry": "changeset version --snapshot next && npm run build && npm publish --workspaces --tag next --dry-run",
    "check:package": "npm run check:package --workspaces",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "aima-api:generate": "node scripts/aima-api/generate.mjs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
